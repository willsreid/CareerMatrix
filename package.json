{
  "name": "career-matrix",
  "version": "1.0.0",
  "private": true,
  "description": "Local-first resume tailoring, cover letters, applications and a portfolio builder.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/copy-pdf-worker.mjs",
    "pdf-worker": "node scripts/copy-pdf-worker.mjs",
    "verify": "tsx scripts/verify-engine.ts",
    "verify:pdf": "esbuild scripts/verify-pdf.mts --bundle --platform=node --format=esm --target=node20 '--external:@react-pdf/*' --external:react --external:react-dom --outfile=tmp/pdf-verify.mjs && node tmp/pdf-verify.mjs",
    "verify:all": "tsx scripts/verify-all.mts",
    "verify:screens": "tsx scripts/verify-screens.mts",
    "preview:templates": "esbuild scripts/template-previews.mts --bundle --platform=node --format=esm --target=node20 '--external:@react-pdf/*' --external:react --external:react-dom --outfile=tmp/template-previews.mjs && node tmp/template-previews.mjs",
    "blank": "tsx scripts/blank.mts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-progress": "^1.1.1",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slider": "^1.2.2",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.2",
    "@react-pdf/renderer": "^4.1.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "lucide-react": "^0.468.0",
    "next": "^14.2.15",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20.17.10",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "jsdom": "^30.1.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
